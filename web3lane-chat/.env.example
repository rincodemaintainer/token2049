# Eve deployment origin, without /eve/v1. Local Eve: http://127.0.0.1:2000
QA_AGENT_URL=http://127.0.0.1:2000
# Optional: only if the agent's channel verifies this bearer credential.
QA_AGENT_BEARER_TOKEN=
# Existing deployed channel accepts a trusted Vercel OIDC token. Tokens expire.
QA_AGENT_VERCEL_OIDC_TOKEN=
# Optional Vercel Deployment Protection bypass. Does NOT replace Eve authentication.
QA_AGENT_VERCEL_BYPASS_TOKEN=
